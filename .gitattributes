
# Default text handling
* text=auto

# Python source files
*.py text eol=lf

# QGIS and Qt Designer files
*.ui text eol=lf
*.qrc text eol=lf

# Plugin metadata and documentation
*.txt text eol=lf
*.html text eol=lf
*.md text eol=lf
*.rst text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.xml text eol=lf

# Git configuration files
.gitignore text eol=lf
.gitattributes text eol=lf
AGENTS.md text eol=lf

# Images and other binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.pdf binary
